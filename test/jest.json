{
  "rootDir": "..",
  "testEnvironment": "jsdom",
  "testEnvironmentOptions": {
    "customExportConditions": ["node", "node-addons"]
  },
  "testMatch": ["<rootDir>/test/**/*.spec.ts"],
  "setupFiles": ["reflect-metadata"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/test/tsconfig.json" }]
  }
}
