    "vue": "^3.0.0"
  },
  "dependencies": {
    "vue-facing-decorator": "3.0.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/superagent": "^4.1.15",
    "eslint": "^8.6.0",
    "jest": "^29.2.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^3.0.2",
    "superagent": "^8.0.2",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
