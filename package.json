{
  "name": "@iappx/vue-facing-di",
  "version": "3.0.6",
  "description": "Dependency injection for Vue class components — a tsyringe-powered wrapper around vue-facing-decorator.",
  "keywords": [
    "vue",
    "vue3",
    "dependency-injection",
    "di",
    "ioc",
    "tsyringe",
    "decorator",
    "vue-facing-decorator",
    "class-component",
    "typescript"
  ],
  "author": "iappx",
  "license": "MIT",
  "homepage": "https://github.com/iappx/vue-facing-di#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iappx/vue-facing-di.git"
  },
  "bugs": {
    "url": "https://github.com/iappx/vue-facing-di/issues"
  },
  "main": "./lib/index.js",
  "typings": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rimraf ./lib && tsc --build tsconfig.json",
